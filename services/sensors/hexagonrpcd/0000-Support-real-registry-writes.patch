From 7f2fc1d5afdd811416a4b1bb5664f2a932f7855f Mon Sep 17 00:00:00 2001
From: Fady <me@fadyackad.dev>
Date: Sat, 19 Sep 2026 23:58:47 +0200
Subject: [PATCH 4/5] rpcd_builder: map the registry's parent directory when
 DIR/sensors/persist exists

The framework writes /persist/sensors/registry/fstempfile and renames it into /persist/sensors/registry/registry, and it looks for sns_reg_version and parsed_file_list.csv next to the registry directory (it creates sns_reg_version through that temporary file when the file is missing). With DIR/sensors/persist/ present that directory backs the whole of /persist/sensors/registry, its registry/ subdirectory being the registry; without it the tree is as before.

Link: https://github.com/linux-msm/hexagonrpc/issues/19
Link: https://github.com/linux-msm/hexagonrpc/pull/21
Signed-off-by: Fady <me@fadyackad.dev>
---
 hexagonrpcd/rpcd_builder.c | 50 ++++++++++++++++++++++++++++++++------
 1 file changed, 43 insertions(+), 7 deletions(-)

diff --git a/hexagonrpcd/rpcd_builder.c b/hexagonrpcd/rpcd_builder.c
index d374958..0d720b3 100644
--- a/hexagonrpcd/rpcd_builder.c
+++ b/hexagonrpcd/rpcd_builder.c
@@ -109,6 +109,48 @@ static struct hexagonfs_dirent *hfs_map_or_empty(const char *name, const char *p
  *
  * TODO: Make this free()-able with reference counts
  */
+#define SENSORS_PERSIST		"/sensors/persist/"
+
+/*
+ * The sensor framework does not only read its registry: while it initialises
+ * it removes and rewrites entries below /persist/sensors/registry/registry
+ * and writes a temporary file next to that directory
+ * (/persist/sensors/registry/fstempfile, renamed into the registry). With
+ * PREFIX/sensors/persist/ present, that directory backs the whole of
+ * /persist/sensors/registry, its registry/ subdirectory being the registry;
+ * otherwise the parent stays virtual and PREFIX/sensors/registry/ is the
+ * registry, as before.
+ */
+static struct hexagonfs_dirent *build_persist_dir(const char *prefix,
+						  const char *sns_reg)
+{
+	struct stat st;
+	char *sns_persist;
+
+	sns_persist = malloc(strlen(prefix) + strlen(SENSORS_PERSIST) + 1);
+	if (sns_persist != NULL) {
+		strcpy(sns_persist, prefix);
+		strcat(sns_persist, SENSORS_PERSIST);
+
+		if (stat(sns_persist, &st) == 0 && S_ISDIR(st.st_mode))
+			return hfs_mkdir("persist", 1,
+					hfs_mkdir("sensors", 1,
+						hfs_map("registry", sns_persist)
+					)
+				);
+
+		free(sns_persist);
+	}
+
+	return hfs_mkdir("persist", 1,
+			hfs_mkdir("sensors", 1,
+				hfs_mkdir("registry", 1,
+					hfs_map("registry", sns_reg)
+				)
+			)
+		);
+}
+
